# ===========================================
# ConectFlow - Environment Variables Example
# Copy this file to .env and fill in values
# ===========================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conectflow"

# ---- Backend ----
PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CORS_ORIGIN=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=ConectFlow

# ---- SGP Integration ----
SGP_BASE_URL=https://sgp.conectstelecom.com.br/api/precadastro
SGP_APP=appprecadastro
SGP_TOKEN=your-sgp-token-here

# ---- File Upload ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- WhatsApp (future) ----
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---- ERP Integration (future) ----
ERP_API_URL=
ERP_API_KEY=
