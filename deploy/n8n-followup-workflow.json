{
  "name": "ConectFlow - Pós-Venda Follow-up WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "followup",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook ConectFlow",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "followup-webhook-id"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nreturn [{\n  json: {\n    EVOLUTION_URL: 'https://evolution.conectplusfibra.com.br',\n    EVOLUTION_INSTANCE: 'cadastro',\n    EVOLUTION_APIKEY: '490DE680E20D-4388-8A0C-9FA200E3EB26',\n    wa_number: String(d.lead?.phone || ''),\n    wa_text: String(d.message || ''),\n    followUpId: String(d.followUpId || ''),\n    callbackUrl: String(d.callbackUrl || '')\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "⚙️ Preparar Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.EVOLUTION_URL + '/message/sendText/' + $json.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.EVOLUTION_APIKEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.wa_number }}"
            },
            {
              "name": "text",
              "value": "={{ $json.wa_text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "followUpId",
              "value": "={{ $json.followUpId }}"
            },
            {
              "name": "success",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Callback ConectFlow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook ConectFlow": {
      "main": [
        [{ "node": "⚙️ Preparar Dados", "type": "main", "index": 0 }]
      ]
    },
    "⚙️ Preparar Dados": {
      "main": [
        [{ "node": "Enviar WhatsApp", "type": "main", "index": 0 }]
      ]
    },
    "Enviar WhatsApp": {
      "main": [
        [{ "node": "Callback ConectFlow", "type": "main", "index": 0 }]
      ]
    }
  },
